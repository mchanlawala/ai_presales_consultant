# ── Ollama (local, default) ──────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:14b          # any model you have pulled in Ollama
EMBEDDING_MODEL=nomic-embed-text

# ── OpenAI (optional – comment out if using Ollama) ──────────────────────────
# OPENAI_API_KEY=sk-...
# LLM_PROVIDER=openai
# OPENAI_MODEL=gpt-4o

# ── Cost per person-month (USD) used by estimator ────────────────────────────
RATE_PER_PERSON_MONTH=8500
